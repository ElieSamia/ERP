# MongoDB Atlas connection string. Vercel fills this in automatically when you add
# MongoDB Atlas from the Vercel Marketplace.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, defaults to travel_erp)
MONGODB_DB=travel_erp

# Secret used to sign sign-in sessions. At least 32 random characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret
